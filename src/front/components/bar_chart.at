// components/bar_chart.at - BarChart component (Plan 437 Phase 2 ② → Plan 484 v2 → Plan 492 M6 → Plan 498 M2)
//
// 柱形图:band scale(槽宽 = 510/n,grouped 槽内 60% 均分系列;stacked
// 单列前缀和堆叠)。渲染端 v1 = SVG 子树直通(442 A4)。
//
// 492 M6(绕开摘除,回归直接写法):Init 内直用 prop 字符串比较
// (`if .type == "stacked"`)选域/段记录,单 segs + 单 yTick 组,view 无
// 分支;带参 msg 声明恢复;band 样式 dollar 插值;484 时代的成对镜像
// 域字段(Init 内两算两存)与 tooltip 双域锚点残留(ay/cum3 死算)一并
// 退役。
// 保留纪律:条件引用的局部变量紧邻使用点声明。
//
// # Usage
// bar-chart (data: .sales, index: "q", fields: ["a", "b"], type: "stacked") {}

use chart_geom: parse_decimal, in_set4, label_of_k, step_m_of, step_e_of
use stylekit.styles: hint_text, caption_text
style legend_swatch = "w-3 h-3 shrink-0"

widget BarChart (keysText: List<str> = [], rowsText: List = [], index: str = "q", fields: List<str> = ["v"], colors: List<str> = ["#2563eb", "#16a34a", "#d97706", "#dc2626"], axis: str = "auto", grid: bool = true, legend: bool = true, labels: List<str> = [], tooltip: bool = true, type: str = "grouped") {
    msg { Init, Hover(int), Toggle(int) }

    model {
        segs0 List = []
        segs1 List = []
        segs2 List = []
        segs3 List = []
        hovBr int = 9
        visBr0 bool = true
        visBr1 bool = true
        visBr2 bool = true
        visBr3 bool = true
        xlabels str = ""
        xLab0 str = ""
        xLab1 str = ""
        xLab2 str = ""
        xLab3 str = ""
        xLab4 str = ""
        xLab5 str = ""
        xLab6 str = ""
        xLab7 str = ""
        xLab8 str = ""
        xLab9 str = ""
        xLab10 str = ""
        xLab11 str = ""
        xLab12 str = ""
        xLab13 str = ""
        xLab14 str = ""
        xLab15 str = ""
        xLab16 str = ""
        xLab17 str = ""
        xLab18 str = ""
        xLab19 str = ""
        barTick4 str = ""
        barTick3 str = ""
        barTick2 str = ""
        barTick1 str = ""
        barTick0 str = ""
        barGrid str = ""
        barBaseY str = "260"
        legendColor0 str = ""
        legendText0 str = ""
        legendColor1 str = ""
        legendText1 str = ""
        legendColor2 str = ""
        legendText2 str = ""
        legendColor3 str = ""
        legendText3 str = ""
        bands List = []
        tipTitles List = []
        tipBodies List = []
        hovered str = "false"
        tipTitle str = ""
        tipBody str = ""
    }

    on {
        .Init -> {
            // ---- 域(type prop 直接选) + 符号值域:带符号 vmin/vmax,
            //      与后端导出 SVG 同一几何合同(y(v)=260-(v-vmin)/span*240,
            //      刻度阶梯 {1,2,5}·10^k,基线 y0=y(0))。
            //      CHARTS-002 T-02:值域/刻度 float 双端统一;数据面改吃
            //      rowsText(字符串单元,app 自 rows_frag 透传)+组件内
            //      parse_decimal 解析——VM 轨 JSON 数字小数在数据通道归零
            //      的框架缺口绕开(standalone-decision §6);列定位用
            //      for-in+计数器(List 索引在册缺陷 F-8 规避) ----
            var idxCol int = -1
            var ccol0 int = -1
            var ccol1 int = -1
            var ccol2 int = -1
            var ccol3 int = -1
            var nk int = 0
            for kk in .keysText {
                if kk == .index {
                    idxCol = nk
                }
                var fi int = 0
                for ff in .fields {
                    if ff == kk {
                        if fi == 0 {
                            ccol0 = nk
                        }
                        if fi == 1 {
                            ccol1 = nk
                        }
                        if fi == 2 {
                            ccol2 = nk
                        }
                        if fi == 3 {
                            ccol3 = nk
                        }
                    }
                    fi = fi + 1
                }
                nk = nk + 1
            }
            var vmax float = 0.0
            var vmin float = 0.0
            var n int = 0
            if .type == "stacked" {
                for row in .rowsText {
                    n = n + 1
                    var cum float = 0.0
                    var ci int = 0
                    for cell in row {
                        if in_set4(ci, ccol0, ccol1, ccol2, ccol3) {
                            var vf float = parse_decimal(cell)
                            cum = cum + vf
                        }
                        ci = ci + 1
                    }
                    if cum > vmax {
                        vmax = cum
                    }
                    if cum < vmin {
                        vmin = cum
                    }
                }
            } else {
                for row in .rowsText {
                    n = n + 1
                    var ci2 int = 0
                    for cell2 in row {
                        if in_set4(ci2, ccol0, ccol1, ccol2, ccol3) {
                            var v float = parse_decimal(cell2)
                            if v > vmax {
                                vmax = v
                            }
                            if v < vmin {
                                vmin = v
                            }
                        }
                        ci2 = ci2 + 1
                    }
                }
            }
            var span float = vmax - vmin
            if span <= 0.0 {
                vmin = 0.0
                vmax = 100.0
                span = 100.0
            }
            // ---- 刻度阶梯 {1,2,5}·10^k(与 chart_project.at 渲染器同式;
            //      k 可为负——span/4 < 1 时下探种子;1e-7 相对边界容差) ----
            var raw float = span / 4.0
            var rawm float = raw - raw / 10000000.0
            var step float = 0.0
            var base float = 1.0
            var guard int = 0
            while base > rawm {
                base = base / 10.0
                guard = guard + 1
                if guard > 12 {
                    break
                }
            }
            while step == 0.0 {
                if base >= rawm {
                    step = base
                }
                if step == 0.0 {
                    if base * 2.0 >= rawm {
                        step = base * 2.0
                    }
                }
                if step == 0.0 {
                    if base * 5.0 >= rawm {
                        step = base * 5.0
                    }
                }
                base = base * 10.0
                guard = guard + 1
                if guard > 28 {
                    step = base
                }
            }
            // ---- 最低可见刻度档位(≥vmin 的最小 step 整倍数的档位号;
            //      tick = k·step 乘法形式免连加漂移;标签 = label_of_k 整数
            //      重构;无取整/无 float→int) ----
            var lm int = step_m_of(step)
            var le int = step_e_of(step)
            var eps float = step / 1000000.0
            var kLo float = 0.0
            var kLoI int = 0
            if vmin > 0.0 {
                var tidx float = 0.0
                var tidxI int = 0
                var ga int = 0
                while tidx * step < vmin - eps {
                    tidx = tidx + 1.0
                    tidxI = tidxI + 1
                    ga = ga + 1
                    if ga > 64 {
                        break
                    }
                }
                kLo = tidx
                kLoI = tidxI
            } else {
                if vmin < 0.0 {
                    var tidx2 float = 0.0
                    var tidxI2 int = 0
                    var gb int = 0
                    while tidx2 * step > vmin + eps {
                        tidx2 = tidx2 - 1.0
                        tidxI2 = tidxI2 - 1
                        gb = gb + 1
                        if gb > 64 {
                            break
                        }
                    }
                    kLo = tidx2
                    kLoI = tidxI2
                }
            }
            // ---- 可见刻度(≤5 槽,自底向上填) ----
            var count int = 0
            var cidx float = kLo
            var gcx int = 0
            while cidx * step <= vmax + eps {
                count = count + 1
                cidx = cidx + 1.0
                gcx = gcx + 1
                if gcx > 64 {
                    break
                }
            }
            if count > 5 {
                count = 5
            }
            var vminf float = vmin
            var spanf float = span
            var bottom float = 260.0
            var spanpx float = 240.0
            // 基线 y(0)(vmin≥0 时贴底,vmax≤0 时贴顶)
            var zf float = 0.0
            var y0 float = bottom - (zf - vminf) / spanf * spanpx
            .barBaseY = f"${y0}"
            // 逐刻度 y 与网格路径(自顶 = 最高档位向下;k·step 乘法形式;
            // 标签 = label_of_k(档位号,m,e) 整数重构)
            var kTop float = kLo
            var kTopI int = kLoI
            var gi2 int = 0
            while gi2 < count - 1 {
                kTop = kTop + 1.0
                kTopI = kTopI + 1
                gi2 = gi2 + 1
            }
            var btk float = kTop * step
            var gy4 float = bottom - (btk - vminf) / spanf * spanpx
            var gv3 float = (kTop - 1.0) * step
            var gy3 float = bottom - (gv3 - vminf) / spanf * spanpx
            var gv2 float = (kTop - 2.0) * step
            var gy2 float = bottom - (gv2 - vminf) / spanf * spanpx
            var gv1 float = (kTop - 3.0) * step
            var gy1 float = bottom - (gv1 - vminf) / spanf * spanpx
            var gv0 float = (kTop - 4.0) * step
            var gy0 float = bottom - (gv0 - vminf) / spanf * spanpx
            .barTick4 = label_of_k(kTopI, lm, le)
            var gp str = f"M40 ${gy4} H550"
            if count >= 2 {
                .barTick3 = label_of_k(kTopI - 1, lm, le)
                gp = gp + f" M40 ${gy3} H550"
            } else {
                .barTick3 = ""
            }
            if count >= 3 {
                .barTick2 = label_of_k(kTopI - 2, lm, le)
                gp = gp + f" M40 ${gy2} H550"
            } else {
                .barTick2 = ""
            }
            if count >= 4 {
                .barTick1 = label_of_k(kTopI - 3, lm, le)
                gp = gp + f" M40 ${gy1} H550"
            } else {
                .barTick1 = ""
            }
            if count >= 5 {
                .barTick0 = label_of_k(kTopI - 4, lm, le)
                gp = gp + f" M40 ${gy0} H550"
            } else {
                .barTick0 = ""
            }
            .barGrid = gp
            var domainf float = span

            var nf float = n
            var slot float = 510.0 / nf
            var ks int = .fields.len()
            var kf float = ks
            var inner float = slot * 0.6
            var barw float = inner / kf
            var cs = .colors
            var ccount int = cs.len()

            // ---- 段记录:type prop 直接选(grouped 槽内并列/stacked 前缀和堆叠);
            //      498 M2:逐柱记录 {d,c,g}(组号 g 驱动分组 emphasis)入逐系列槽位 ----
            var out0 List = []
            var out1 List = []
            var out2 List = []
            var out3 List = []
            var k = 0
            for f in .fields {
                var colK int = -1
                if k == 0 {
                    colK = ccol0
                }
                if k == 1 {
                    colK = ccol1
                }
                if k == 2 {
                    colK = ccol2
                }
                if k == 3 {
                    colK = ccol3
                }
                var i = 0
                for row in .rowsText {
                    var cellK str = ""
                    var before float = 0.0
                    var ci3 int = 0
                    for cell in row {
                        if ci3 == colK {
                            if colK >= 0 {
                                cellK = cell
                            }
                        }
                        if ci3 == ccol0 {
                            if k > 0 {
                                var vb0 float = parse_decimal(cell)
                                before = before + vb0
                            }
                        }
                        if ci3 == ccol1 {
                            if k > 1 {
                                var vb1 float = parse_decimal(cell)
                                before = before + vb1
                            }
                        }
                        if ci3 == ccol2 {
                            if k > 2 {
                                var vb2 float = parse_decimal(cell)
                                before = before + vb2
                            }
                        }
                        ci3 = ci3 + 1
                    }
                    var xf float = 40.0 + i * slot + slot * 0.2
                    var rstr = ""
                    if .type == "stacked" {
                        // 前缀和底边:前面系列累计抬升;段跨越基线按符号取
                        // 顶/高(v≥0 段在基线上方,反之向下)
                        var vf float = parse_decimal(cellK)
                        var beforef float = before
                        var allf float = vf + beforef
                        var ysegtop float = bottom - (allf - vminf) / domainf * spanpx
                        var ybaseS float = bottom - (beforef - vminf) / domainf * spanpx
                        var rtopS float = ysegtop
                        var rhS float = ybaseS - ysegtop
                        if vf < 0.0 {
                            rtopS = ybaseS
                            rhS = ysegtop - ybaseS
                        }
                        rstr = f"M${xf} ${rtopS} h${inner} v${rhS} h-${inner} Z"
                    } else {
                        var vfg float = parse_decimal(cellK)
                        var ytop float = bottom - (vfg - vminf) / domainf * spanpx
                        var rtop float = ytop
                        var rh float = y0 - ytop
                        if vfg < 0.0 {
                            rtop = y0
                            rh = ytop - y0
                        }
                        var xfg float = xf + k * barw
                        rstr = f"M${xfg} ${rtop} h${barw} v${rh} h-${barw} Z"
                    }
                    var ci int = k
                    if ci >= ccount {
                        ci = ccount - 1
                    }
                    var rcol = cs[ci]
                    if k == 0 {
                        out0.push({ d: rstr, c: rcol, g: i })
                    }
                    if k == 1 {
                        out1.push({ d: rstr, c: rcol, g: i })
                    }
                    if k == 2 {
                        out2.push({ d: rstr, c: rcol, g: i })
                    }
                    if k == 3 {
                        out3.push({ d: rstr, c: rcol, g: i })
                    }
                    i = i + 1
                }
                var cik int = k
                if cik >= ccount {
                    cik = ccount - 1
                }
                var color = cs[cik]
                var name = .fields[k]
                var lname = .labels
                if lname.len() > k {
                    name = lname[k]
                }
                if k == 0 {
                    .legendColor0 = color
                    .legendText0 = name
                }
                if k == 1 {
                    .legendColor1 = color
                    .legendText1 = name
                }
                if k == 2 {
                    .legendColor2 = color
                    .legendText2 = name
                }
                if k == 3 {
                    .legendColor3 = color
                    .legendText3 = name
                }
                k = k + 1
            }
            .segs0 = out0
            .segs1 = out1
            .segs2 = out2
            .segs3 = out3

            // ---- x 轴标签:逐数据点槽位(≤20 全量对齐,超出等距抽样) ----
            var KL int = n
            if KL > 20 {
                KL = 20
            }
            var den int = 1
            if KL > 1 {
                den = KL - 1
            }
            var outL List = []
            var nxt int = 0
            var i4 = 0
            for row4 in .rowsText {
                var catL str = ""
                var ci4 int = 0
                for cell4 in row4 {
                    if ci4 == idxCol {
                        if idxCol >= 0 {
                            catL = cell4
                        }
                    }
                    ci4 = ci4 + 1
                }
                var tgt int = nxt * (n - 1) / den
                if i4 == tgt && nxt < KL {
                    outL.push(catL)
                    nxt = nxt + 1
                }
                i4 = i4 + 1
            }
            if KL > 0 {
                var sv0 = outL[0]
                .xLab0 = sv0
            }
            if KL > 1 {
                var sv1 = outL[1]
                .xLab1 = sv1
            }
            if KL > 2 {
                var sv2 = outL[2]
                .xLab2 = sv2
            }
            if KL > 3 {
                var sv3 = outL[3]
                .xLab3 = sv3
            }
            if KL > 4 {
                var sv4 = outL[4]
                .xLab4 = sv4
            }
            if KL > 5 {
                var sv5 = outL[5]
                .xLab5 = sv5
            }
            if KL > 6 {
                var sv6 = outL[6]
                .xLab6 = sv6
            }
            if KL > 7 {
                var sv7 = outL[7]
                .xLab7 = sv7
            }
            if KL > 8 {
                var sv8 = outL[8]
                .xLab8 = sv8
            }
            if KL > 9 {
                var sv9 = outL[9]
                .xLab9 = sv9
            }
            if KL > 10 {
                var sv10 = outL[10]
                .xLab10 = sv10
            }
            if KL > 11 {
                var sv11 = outL[11]
                .xLab11 = sv11
            }
            if KL > 12 {
                var sv12 = outL[12]
                .xLab12 = sv12
            }
            if KL > 13 {
                var sv13 = outL[13]
                .xLab13 = sv13
            }
            if KL > 14 {
                var sv14 = outL[14]
                .xLab14 = sv14
            }
            if KL > 15 {
                var sv15 = outL[15]
                .xLab15 = sv15
            }
            if KL > 16 {
                var sv16 = outL[16]
                .xLab16 = sv16
            }
            if KL > 17 {
                var sv17 = outL[17]
                .xLab17 = sv17
            }
            if KL > 18 {
                var sv18 = outL[18]
                .xLab18 = sv18
            }
            if KL > 19 {
                var sv19 = outL[19]
                .xLab19 = sv19
            }

            // ---- 命中竖带 + tooltip 内容(逐索引预计算;单元原串展示) ----
            var nm0 str = .fields[0]
            if .labels.len() > 0 {
                nm0 = .labels[0]
            }
            var nm1 str = ""
            if .fields.len() > 1 {
                nm1 = .fields[1]
                if .labels.len() > 1 {
                    nm1 = .labels[1]
                }
            }
            var nm2 str = ""
            if .fields.len() > 2 {
                nm2 = .fields[2]
                if .labels.len() > 2 {
                    nm2 = .labels[2]
                }
            }
            var nm3 str = ""
            if .fields.len() > 3 {
                nm3 = .fields[3]
                if .labels.len() > 3 {
                    nm3 = .labels[3]
                }
            }
            var outBands List = []
            var outTipTitle List = []
            var outTipBody List = []
            var i3 = 0
            for row5 in .rowsText {
                outBands.push({ i: i3, s: f"w-[${slot}px] h-full flex-1" })
                var catT str = ""
                var body = ""
                var ci5 int = 0
                for cell5 in row5 {
                    if ci5 == idxCol {
                        if idxCol >= 0 {
                            catT = cell5
                        }
                    }
                    if ci5 == ccol0 {
                        if body == "" {
                            body = f"${nm0} ${cell5}"
                        } else {
                            body = body + "\n" + f"${nm0} ${cell5}"
                        }
                    }
                    if ci5 == ccol1 {
                        if body == "" {
                            body = f"${nm1} ${cell5}"
                        } else {
                            body = body + "\n" + f"${nm1} ${cell5}"
                        }
                    }
                    if ci5 == ccol2 {
                        if body == "" {
                            body = f"${nm2} ${cell5}"
                        } else {
                            body = body + "\n" + f"${nm2} ${cell5}"
                        }
                    }
                    if ci5 == ccol3 {
                        if body == "" {
                            body = f"${nm3} ${cell5}"
                        } else {
                            body = body + "\n" + f"${nm3} ${cell5}"
                        }
                    }
                    ci5 = ci5 + 1
                }
                outTipTitle.push(catT)
                outTipBody.push(body)
                i3 = i3 + 1
            }
            .bands = outBands
            .tipTitles = outTipTitle
            .tipBodies = outTipBody
        }

        .Hover(i) -> {
            .hovered = "true"
            .hovBr = i
            var tt = .tipTitles[i]
            var tb = .tipBodies[i]
            .tipTitle = tt
            .tipBody = tb
        }
        .HoverOut -> {
            .hovered = "false"
            .hovBr = 9
        }
        .Toggle(k) -> {
            if k == 0 {
                .visBr0 = !.visBr0
            }
            if k == 1 {
                .visBr1 = !.visBr1
            }
            if k == 2 {
                .visBr2 = !.visBr2
            }
            if k == 3 {
                .visBr3 = !.visBr3
            }
        }
    }

    style {
        /* 498 M2: emphasis 淡入——vue 走 CSS transition,VM 直接切换。 */
        path { transition: stroke-width 0.15s ease, fill-opacity 0.15s ease; }
    }

    view {
        col (style: "w-full max-w-[560px] mx-auto gap-1") {
            if .legend {
                row (style: "justify-end gap-4 pb-2") {
                    if .legendText0 != "" {
                        mouse-area (onclick: .Toggle(0)) {
                            row (style: ["items-center gap-1", if .visBr0 { "" } else { "opacity-40" }]) {
                                svg (viewBox: "0 0 8 8", style: legend_swatch) {
                                    rect (width: "8", height: "8", fill: .legendColor0) {}
                                }
                                text .legendText0 { style: caption_text }
                            }
                        }
                    }
                    if .legendText1 != "" {
                        mouse-area (onclick: .Toggle(1)) {
                            row (style: ["items-center gap-1", if .visBr1 { "" } else { "opacity-40" }]) {
                                svg (viewBox: "0 0 8 8", style: legend_swatch) {
                                    rect (width: "8", height: "8", fill: .legendColor1) {}
                                }
                                text .legendText1 { style: caption_text }
                            }
                        }
                    }
                    if .legendText2 != "" {
                        mouse-area (onclick: .Toggle(2)) {
                            row (style: ["items-center gap-1", if .visBr2 { "" } else { "opacity-40" }]) {
                                svg (viewBox: "0 0 8 8", style: legend_swatch) {
                                    rect (width: "8", height: "8", fill: .legendColor2) {}
                                }
                                text .legendText2 { style: caption_text }
                            }
                        }
                    }
                    if .legendText3 != "" {
                        mouse-area (onclick: .Toggle(3)) {
                            row (style: ["items-center gap-1", if .visBr3 { "" } else { "opacity-40" }]) {
                                svg (viewBox: "0 0 8 8", style: legend_swatch) {
                                    rect (width: "8", height: "8", fill: .legendColor3) {}
                                }
                                text .legendText3 { style: caption_text }
                            }
                        }
                    }
                }
            }
            row (style: "items-stretch w-full") {
                if .axis == "auto" {
                    col (style: "w-10 shrink-0 justify-between items-end pr-1 pt-[20px] pb-[40px]") {
                        text .barTick4 { style: hint_text }
                        text .barTick3 { style: hint_text }
                        text .barTick2 { style: hint_text }
                        text .barTick1 { style: hint_text }
                        text .barTick0 { style: hint_text }
                    }
                }
                col (style: "flex-1") {
                    col (style: "relative") {
                        svg (viewBox: "0 0 560 300", style: "w-full h-auto") {
                            if .grid {
                                path (d: .barGrid, stroke: "#e2e8f0", stroke-width: "1") {}
                            }
                            line (x1: "40", y1: "20", x2: "40", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                            line (x1: "40", y1: .barBaseY, x2: "550", y2: .barBaseY, stroke: "#94a3b8", stroke-width: "1") {}
                            if .legendText0 != "" {
                              if .visBr0 {
                                for seg in .segs0 {
                                    if .hovBr == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hovBr == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                              }
                            }
                            if .legendText1 != "" {
                              if .visBr1 {
                                for seg in .segs1 {
                                    if .hovBr == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hovBr == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                              }
                            }
                            if .legendText2 != "" {
                              if .visBr2 {
                                for seg in .segs2 {
                                    if .hovBr == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hovBr == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                              }
                            }
                            if .legendText3 != "" {
                              if .visBr3 {
                                for seg in .segs3 {
                                    if .hovBr == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hovBr == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                              }
                            }
                        }
                        if .tooltip {
                            col (style: "absolute top-[20px] left-[40px] z-50 w-[510px] h-[240px]") {
                                row (style: "h-full") {
                                    for b in .bands {
                                        mouse-area (key: b["i"], style: b["s"], onmouseenter: .Hover(b.i), onmouseleave: .HoverOut) {}
                                    }
                                }
                            }
                            if .hovered == "true" {
                                col (style: "absolute top-[28px] right-[60px] z-50 bg-popover border rounded-md px-2 py-1 shadow-md") {
                                    text .tipTitle { style: "text-xs font-semibold text-foreground" }
                                    text .tipBody { style: "text-xs text-muted-foreground whitespace-pre-line" }
                                }
                            }
                        }
                    }
                    if .axis == "auto" {
                        row (style: "justify-between pl-10 pr-2.5 pt-1") {
                                if .xLab0 != "" {
                                    text .xLab0 { style: hint_text }
                                }
                                if .xLab1 != "" {
                                    text .xLab1 { style: hint_text }
                                }
                                if .xLab2 != "" {
                                    text .xLab2 { style: hint_text }
                                }
                                if .xLab3 != "" {
                                    text .xLab3 { style: hint_text }
                                }
                                if .xLab4 != "" {
                                    text .xLab4 { style: hint_text }
                                }
                                if .xLab5 != "" {
                                    text .xLab5 { style: hint_text }
                                }
                                if .xLab6 != "" {
                                    text .xLab6 { style: hint_text }
                                }
                                if .xLab7 != "" {
                                    text .xLab7 { style: hint_text }
                                }
                                if .xLab8 != "" {
                                    text .xLab8 { style: hint_text }
                                }
                                if .xLab9 != "" {
                                    text .xLab9 { style: hint_text }
                                }
                                if .xLab10 != "" {
                                    text .xLab10 { style: hint_text }
                                }
                                if .xLab11 != "" {
                                    text .xLab11 { style: hint_text }
                                }
                                if .xLab12 != "" {
                                    text .xLab12 { style: hint_text }
                                }
                                if .xLab13 != "" {
                                    text .xLab13 { style: hint_text }
                                }
                                if .xLab14 != "" {
                                    text .xLab14 { style: hint_text }
                                }
                                if .xLab15 != "" {
                                    text .xLab15 { style: hint_text }
                                }
                                if .xLab16 != "" {
                                    text .xLab16 { style: hint_text }
                                }
                                if .xLab17 != "" {
                                    text .xLab17 { style: hint_text }
                                }
                                if .xLab18 != "" {
                                    text .xLab18 { style: hint_text }
                                }
                                if .xLab19 != "" {
                                    text .xLab19 { style: hint_text }
                                }
                        }
                    }
                }
            }
        }
    }
}
