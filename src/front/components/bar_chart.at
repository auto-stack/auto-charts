// components/bar_chart.at - BarChart component (Plan 437 Phase 2 ② → Plan 484 v2 → Plan 492 M6 → Plan 498 M2)
//
// 柱形图:band scale(槽宽 = 510/n,grouped 槽内 60% 均分系列;stacked
// 单列前缀和堆叠)。渲染端 v1 = SVG 子树直通(442 A4)。
//
// 492 M6(绕开摘除,回归直接写法):Init 内直用 prop 字符串比较
// (`if .type == "stacked"`)选域/段记录,单 segs + 单 yTick 组,view 无
// 分支;带参 msg 声明恢复;band 样式 dollar 插值;484 时代的成对镜像
// 域字段(Init 内两算两存)与 tooltip 双域锚点残留(ay/cum3 死算)一并
// 退役。
// 保留纪律:条件引用的局部变量紧邻使用点声明。
//
// # Usage
// bar-chart (data: .sales, index: "q", fields: ["a", "b"], type: "stacked") {}

use stylekit.styles: hint_text, caption_text
style legend_swatch = "w-3 h-3 shrink-0"

widget BarChart (data: List, index: str = "q", fields: List<str> = ["v"], colors: List<str> = ["#2563eb", "#16a34a", "#d97706", "#dc2626"], axis: str = "auto", grid: bool = true, legend: bool = true, labels: List<str> = [], tooltip: bool = true, type: str = "grouped") {
    msg { Init, Hover(int), Toggle(int) }

    model {
        segs0 List = []
        segs1 List = []
        segs2 List = []
        segs3 List = []
        hovBr int = 9
        visBr0 bool = true
        visBr1 bool = true
        visBr2 bool = true
        visBr3 bool = true
        xlabels str = ""
        xLab0 str = ""
        xLab1 str = ""
        xLab2 str = ""
        xLab3 str = ""
        xLab4 str = ""
        xLab5 str = ""
        xLab6 str = ""
        xLab7 str = ""
        xLab8 str = ""
        xLab9 str = ""
        xLab10 str = ""
        xLab11 str = ""
        xLab12 str = ""
        xLab13 str = ""
        xLab14 str = ""
        xLab15 str = ""
        xLab16 str = ""
        xLab17 str = ""
        xLab18 str = ""
        xLab19 str = ""
        barTick4 str = ""
        barTick3 str = ""
        barTick2 str = ""
        barTick1 str = ""
        barTick0 str = ""
        barGrid str = ""
        barBaseY str = "260"
        legendColor0 str = ""
        legendText0 str = ""
        legendColor1 str = ""
        legendText1 str = ""
        legendColor2 str = ""
        legendText2 str = ""
        legendColor3 str = ""
        legendText3 str = ""
        bands List = []
        tipTitles List = []
        tipBodies List = []
        hovered str = "false"
        tipTitle str = ""
        tipBody str = ""
    }

    on {
        .Init -> {
            // ---- 域(type prop 直接选) + 符号值域:带符号 vmin/vmax,
            //      与后端导出 SVG 同一几何合同(y(v)=260-(v-vmin)/span*240,
            //      刻度阶梯 {1,2,5}·10^k,基线 y0=y(0)) ----
            var vmax int = 0
            var vmin int = 0
            if .type == "stacked" {
                for d in .data {
                    var cum int = 0
                    for f in .fields {
                        var vs1 str = (d[f]).to_string()
                        var dot1 int = vs1.find(".")
                        var v0 int = 0
                        if dot1 >= 0 {
                            v0 = vs1.substr(0, dot1).to_int()
                        } else {
                            v0 = vs1.to_int()
                        }
                        cum = cum + v0
                    }
                    if cum > vmax {
                        vmax = cum
                    }
                    if cum < vmin {
                        vmin = cum
                    }
                }
            } else {
                for d in .data {
                    for f in .fields {
                        var vs0 str = (d[f]).to_string()
                        var dot0 int = vs0.find(".")
                        var v int = 0
                        if dot0 >= 0 {
                            v = vs0.substr(0, dot0).to_int()
                        } else {
                            v = vs0.to_int()
                        }
                        if v > vmax {
                            vmax = v
                        }
                        if v < vmin {
                            vmin = v
                        }
                    }
                }
            }
            var span int = vmax - vmin
            if span <= 0 {
                vmin = 0
                vmax = 100
                span = 100
            }
            // ---- 刻度阶梯 {1,2,5}·10^k(与 chart_project.at 渲染器同式) ----
            var raw int = span / 4
            if raw < 1 {
                raw = 1
            }
            var step int = 0
            var base int = 1
            var guard int = 0
            while step == 0 {
                if base >= raw {
                    step = base
                }
                if step == 0 {
                    if base * 2 >= raw {
                        step = base * 2
                    }
                }
                if step == 0 {
                    if base * 5 >= raw {
                        step = base * 5
                    }
                }
                base = base * 10
                guard = guard + 1
                if guard > 12 {
                    step = base
                }
            }
            // ---- 可见刻度(≤5 槽,自底向上填) ----
            var m int = vmin / step
            if vmin - m * step != 0 {
                if vmin > 0 {
                    m = m + 1
                }
            }
            var tickLo int = m * step
            var count int = (vmax - tickLo) / step + 1
            if count > 5 {
                count = 5
            }
            var btk int = tickLo + (count - 1) * step
            var vminf float = vmin
            var spanf float = span
            var bottom float = 260.0
            var spanpx float = 240.0
            // 基线 y(0)(vmin≥0 时贴底,vmax≤0 时贴顶)
            var zf float = 0.0
            var y0 float = bottom - (zf - vminf) / spanf * spanpx
            .barBaseY = f"${y0}"
            // 逐刻度 y 与网格路径(自顶 = 最高刻度 btk 向下;int 求值后
            // 显式存储强转 float——几何纪律)
            var gf float = btk
            var gy4 float = bottom - (gf - vminf) / spanf * spanpx
            var gv3 int = btk - step
            var gv3f float = gv3
            var gy3 float = bottom - (gv3f - vminf) / spanf * spanpx
            var gv2 int = btk - step * 2
            var gv2f float = gv2
            var gy2 float = bottom - (gv2f - vminf) / spanf * spanpx
            var gv1 int = btk - step * 3
            var gv1f float = gv1
            var gy1 float = bottom - (gv1f - vminf) / spanf * spanpx
            var gv0 int = btk - step * 4
            var gv0f float = gv0
            var gy0 float = bottom - (gv0f - vminf) / spanf * spanpx
            .barTick4 = f"${btk}"
            var gp str = f"M40 ${gy4} H550"
            if count >= 2 {
                .barTick3 = f"${gv3}"
                gp = gp + f" M40 ${gy3} H550"
            } else {
                .barTick3 = ""
            }
            if count >= 3 {
                .barTick2 = f"${gv2}"
                gp = gp + f" M40 ${gy2} H550"
            } else {
                .barTick2 = ""
            }
            if count >= 4 {
                .barTick1 = f"${gv1}"
                gp = gp + f" M40 ${gy1} H550"
            } else {
                .barTick1 = ""
            }
            if count >= 5 {
                .barTick0 = f"${gv0}"
                gp = gp + f" M40 ${gy0} H550"
            } else {
                .barTick0 = ""
            }
            .barGrid = gp
            var domainf float = span

            var n int = .data.len()
            var nf float = n
            var slot float = 510.0 / nf
            var ks int = .fields.len()
            var kf float = ks
            var inner float = slot * 0.6
            var barw float = inner / kf
            var cs = .colors
            var ccount int = cs.len()
            var iname = .index

            // ---- 段记录:type prop 直接选(grouped 槽内并列/stacked 前缀和堆叠);
            //      498 M2:逐柱记录 {d,c,g}(组号 g 驱动分组 emphasis)入逐系列槽位 ----
            var out0 List = []
            var out1 List = []
            var out2 List = []
            var out3 List = []
            var k = 0
            for f in .fields {
                var i = 0
                for d in .data {
                    var xf float = 40.0 + i * slot + slot * 0.2
                    var rstr = ""
                    if .type == "stacked" {
                        // 前缀和底边:前面系列累计抬升;段跨越基线按符号取
                        // 顶/高(v≥0 段在基线上方,反之向下)
                        var before int = 0
                        var k2 = 0
                        for f2 in .fields {
                            if k2 < k {
                                var v2 = d[f2]
                                before = before + v2
                            }
                            k2 = k2 + 1
                        }
                        var vf float = d[f]
                        var beforef float = before
                        var allf float = vf + beforef
                        var ysegtop float = bottom - (allf - vminf) / domainf * spanpx
                        var ybaseS float = bottom - (beforef - vminf) / domainf * spanpx
                        var rtopS float = ysegtop
                        var rhS float = ybaseS - ysegtop
                        if vf < 0.0 {
                            rtopS = ybaseS
                            rhS = ysegtop - ybaseS
                        }
                        rstr = f"M${xf} ${rtopS} h${inner} v${rhS} h-${inner} Z"
                    } else {
                        var vfg float = d[f]
                        var ytop float = bottom - (vfg - vminf) / domainf * spanpx
                        var rtop float = ytop
                        var rh float = y0 - ytop
                        if vfg < 0.0 {
                            rtop = y0
                            rh = ytop - y0
                        }
                        var xfg float = xf + k * barw
                        rstr = f"M${xfg} ${rtop} h${barw} v${rh} h-${barw} Z"
                    }
                    var ci int = k
                    if ci >= ccount {
                        ci = ccount - 1
                    }
                    var rcol = cs[ci]
                    if k == 0 {
                        out0.push({ d: rstr, c: rcol, g: i })
                    }
                    if k == 1 {
                        out1.push({ d: rstr, c: rcol, g: i })
                    }
                    if k == 2 {
                        out2.push({ d: rstr, c: rcol, g: i })
                    }
                    if k == 3 {
                        out3.push({ d: rstr, c: rcol, g: i })
                    }
                    i = i + 1
                }
                var cik int = k
                if cik >= ccount {
                    cik = ccount - 1
                }
                var color = cs[cik]
                var name = .fields[k]
                var lname = .labels
                if lname.len() > k {
                    name = lname[k]
                }
                if k == 0 {
                    .legendColor0 = color
                    .legendText0 = name
                }
                if k == 1 {
                    .legendColor1 = color
                    .legendText1 = name
                }
                if k == 2 {
                    .legendColor2 = color
                    .legendText2 = name
                }
                if k == 3 {
                    .legendColor3 = color
                    .legendText3 = name
                }
                k = k + 1
            }
            .segs0 = out0
            .segs1 = out1
            .segs2 = out2
            .segs3 = out3

            // ---- x 轴标签:逐数据点槽位(≤20 全量对齐,超出等距抽样) ----
            var KL int = n
            if KL > 20 {
                KL = 20
            }
            var den int = 1
            if KL > 1 {
                den = KL - 1
            }
            var outL List = []
            var nxt int = 0
            var i4 = 0
            for d in .data {
                var tgt int = nxt * (n - 1) / den
                if i4 == tgt && nxt < KL {
                    outL.push(d[iname])
                    nxt = nxt + 1
                }
                i4 = i4 + 1
            }
            if KL > 0 {
                var sv0 = outL[0]
                .xLab0 = sv0
            }
            if KL > 1 {
                var sv1 = outL[1]
                .xLab1 = sv1
            }
            if KL > 2 {
                var sv2 = outL[2]
                .xLab2 = sv2
            }
            if KL > 3 {
                var sv3 = outL[3]
                .xLab3 = sv3
            }
            if KL > 4 {
                var sv4 = outL[4]
                .xLab4 = sv4
            }
            if KL > 5 {
                var sv5 = outL[5]
                .xLab5 = sv5
            }
            if KL > 6 {
                var sv6 = outL[6]
                .xLab6 = sv6
            }
            if KL > 7 {
                var sv7 = outL[7]
                .xLab7 = sv7
            }
            if KL > 8 {
                var sv8 = outL[8]
                .xLab8 = sv8
            }
            if KL > 9 {
                var sv9 = outL[9]
                .xLab9 = sv9
            }
            if KL > 10 {
                var sv10 = outL[10]
                .xLab10 = sv10
            }
            if KL > 11 {
                var sv11 = outL[11]
                .xLab11 = sv11
            }
            if KL > 12 {
                var sv12 = outL[12]
                .xLab12 = sv12
            }
            if KL > 13 {
                var sv13 = outL[13]
                .xLab13 = sv13
            }
            if KL > 14 {
                var sv14 = outL[14]
                .xLab14 = sv14
            }
            if KL > 15 {
                var sv15 = outL[15]
                .xLab15 = sv15
            }
            if KL > 16 {
                var sv16 = outL[16]
                .xLab16 = sv16
            }
            if KL > 17 {
                var sv17 = outL[17]
                .xLab17 = sv17
            }
            if KL > 18 {
                var sv18 = outL[18]
                .xLab18 = sv18
            }
            if KL > 19 {
                var sv19 = outL[19]
                .xLab19 = sv19
            }

            // ---- 命中竖带 + tooltip 内容(逐索引预计算) ----
            var outBands List = []
            var outTipTitle List = []
            var outTipBody List = []
            var i3 = 0
            for d in .data {
                outBands.push({ i: i3, s: f"w-[${slot}px] h-full flex-1" })
                outTipTitle.push(d[iname])
                var body = ""
                var k3 = 0
                for f5 in .fields {
                    var name2 = .fields[k3]
                    var lname2 = .labels
                    if lname2.len() > k3 {
                        name2 = lname2[k3]
                    }
                    if body == "" {
                        body = f"${name2} ${d[f5]}"
                    } else {
                        body = body + "\n" + f"${name2} ${d[f5]}"
                    }
                    k3 = k3 + 1
                }
                outTipBody.push(body)
                i3 = i3 + 1
            }
            .bands = outBands
            .tipTitles = outTipTitle
            .tipBodies = outTipBody
        }

        .Hover(i) -> {
            .hovered = "true"
            .hovBr = i
            var tt = .tipTitles[i]
            var tb = .tipBodies[i]
            .tipTitle = tt
            .tipBody = tb
        }
        .HoverOut -> {
            .hovered = "false"
            .hovBr = 9
        }
        .Toggle(k) -> {
            if k == 0 {
                .visBr0 = !.visBr0
            }
            if k == 1 {
                .visBr1 = !.visBr1
            }
            if k == 2 {
                .visBr2 = !.visBr2
            }
            if k == 3 {
                .visBr3 = !.visBr3
            }
        }
    }

    style {
        /* 498 M2: emphasis 淡入——vue 走 CSS transition,VM 直接切换。 */
        path { transition: stroke-width 0.15s ease, fill-opacity 0.15s ease; }
    }

    view {
        col (style: "w-full max-w-[560px] mx-auto gap-1") {
            if .legend {
                row (style: "justify-end gap-4 pb-2") {
                    if .legendText0 != "" {
                        mouse-area (onclick: .Toggle(0)) {
                            row (style: ["items-center gap-1", if .visBr0 { "" } else { "opacity-40" }]) {
                                svg (viewBox: "0 0 8 8", style: legend_swatch) {
                                    rect (width: "8", height: "8", fill: .legendColor0) {}
                                }
                                text .legendText0 { style: caption_text }
                            }
                        }
                    }
                    if .legendText1 != "" {
                        mouse-area (onclick: .Toggle(1)) {
                            row (style: ["items-center gap-1", if .visBr1 { "" } else { "opacity-40" }]) {
                                svg (viewBox: "0 0 8 8", style: legend_swatch) {
                                    rect (width: "8", height: "8", fill: .legendColor1) {}
                                }
                                text .legendText1 { style: caption_text }
                            }
                        }
                    }
                    if .legendText2 != "" {
                        mouse-area (onclick: .Toggle(2)) {
                            row (style: ["items-center gap-1", if .visBr2 { "" } else { "opacity-40" }]) {
                                svg (viewBox: "0 0 8 8", style: legend_swatch) {
                                    rect (width: "8", height: "8", fill: .legendColor2) {}
                                }
                                text .legendText2 { style: caption_text }
                            }
                        }
                    }
                    if .legendText3 != "" {
                        mouse-area (onclick: .Toggle(3)) {
                            row (style: ["items-center gap-1", if .visBr3 { "" } else { "opacity-40" }]) {
                                svg (viewBox: "0 0 8 8", style: legend_swatch) {
                                    rect (width: "8", height: "8", fill: .legendColor3) {}
                                }
                                text .legendText3 { style: caption_text }
                            }
                        }
                    }
                }
            }
            row (style: "items-stretch w-full") {
                if .axis == "auto" {
                    col (style: "w-10 shrink-0 justify-between items-end pr-1 pt-[20px] pb-[40px]") {
                        text .barTick4 { style: hint_text }
                        text .barTick3 { style: hint_text }
                        text .barTick2 { style: hint_text }
                        text .barTick1 { style: hint_text }
                        text .barTick0 { style: hint_text }
                    }
                }
                col (style: "flex-1") {
                    col (style: "relative") {
                        svg (viewBox: "0 0 560 300", style: "w-full h-auto") {
                            if .grid {
                                path (d: .barGrid, stroke: "#e2e8f0", stroke-width: "1") {}
                            }
                            line (x1: "40", y1: "20", x2: "40", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                            line (x1: "40", y1: .barBaseY, x2: "550", y2: .barBaseY, stroke: "#94a3b8", stroke-width: "1") {}
                            if .legendText0 != "" {
                              if .visBr0 {
                                for seg in .segs0 {
                                    if .hovBr == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hovBr == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                              }
                            }
                            if .legendText1 != "" {
                              if .visBr1 {
                                for seg in .segs1 {
                                    if .hovBr == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hovBr == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                              }
                            }
                            if .legendText2 != "" {
                              if .visBr2 {
                                for seg in .segs2 {
                                    if .hovBr == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hovBr == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                              }
                            }
                            if .legendText3 != "" {
                              if .visBr3 {
                                for seg in .segs3 {
                                    if .hovBr == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hovBr == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                              }
                            }
                        }
                        if .tooltip {
                            col (style: "absolute top-[20px] left-[40px] z-50 w-[510px] h-[240px]") {
                                row (style: "h-full") {
                                    for b in .bands {
                                        mouse-area (key: b["i"], style: b["s"], onmouseenter: .Hover(b.i), onmouseleave: .HoverOut) {}
                                    }
                                }
                            }
                            if .hovered == "true" {
                                col (style: "absolute top-[28px] right-[60px] z-50 bg-popover border rounded-md px-2 py-1 shadow-md") {
                                    text .tipTitle { style: "text-xs font-semibold text-foreground" }
                                    text .tipBody { style: "text-xs text-muted-foreground whitespace-pre-line" }
                                }
                            }
                        }
                    }
                    if .axis == "auto" {
                        row (style: "justify-between pl-10 pr-2.5 pt-1") {
                                if .xLab0 != "" {
                                    text .xLab0 { style: hint_text }
                                }
                                if .xLab1 != "" {
                                    text .xLab1 { style: hint_text }
                                }
                                if .xLab2 != "" {
                                    text .xLab2 { style: hint_text }
                                }
                                if .xLab3 != "" {
                                    text .xLab3 { style: hint_text }
                                }
                                if .xLab4 != "" {
                                    text .xLab4 { style: hint_text }
                                }
                                if .xLab5 != "" {
                                    text .xLab5 { style: hint_text }
                                }
                                if .xLab6 != "" {
                                    text .xLab6 { style: hint_text }
                                }
                                if .xLab7 != "" {
                                    text .xLab7 { style: hint_text }
                                }
                                if .xLab8 != "" {
                                    text .xLab8 { style: hint_text }
                                }
                                if .xLab9 != "" {
                                    text .xLab9 { style: hint_text }
                                }
                                if .xLab10 != "" {
                                    text .xLab10 { style: hint_text }
                                }
                                if .xLab11 != "" {
                                    text .xLab11 { style: hint_text }
                                }
                                if .xLab12 != "" {
                                    text .xLab12 { style: hint_text }
                                }
                                if .xLab13 != "" {
                                    text .xLab13 { style: hint_text }
                                }
                                if .xLab14 != "" {
                                    text .xLab14 { style: hint_text }
                                }
                                if .xLab15 != "" {
                                    text .xLab15 { style: hint_text }
                                }
                                if .xLab16 != "" {
                                    text .xLab16 { style: hint_text }
                                }
                                if .xLab17 != "" {
                                    text .xLab17 { style: hint_text }
                                }
                                if .xLab18 != "" {
                                    text .xLab18 { style: hint_text }
                                }
                                if .xLab19 != "" {
                                    text .xLab19 { style: hint_text }
                                }
                        }
                    }
                }
            }
        }
    }
}
